---
import { useLocale } from '../i18n';
import { Separator } from '@/components/starwind/separator';
import BrandLogo from './BrandLogo.astro';
import BrandWordmark from './BrandWordmark.astro';
import Icon from './icons/Icon.astro';
import { GAME } from '../config/game';
import { SITE_URL } from '../config/site';
import { isProductHrefEnabled } from '../config/catalog';
import type { FooterLink } from '@/i18n/types';

const { t, lp } = useLocale(Astro.currentLocale);

const [trademarkBefore, trademarkAfter = ''] = t.footer.trademark.split('{game}');

function columnLinkHref(link: FooterLink): string {
  if (link.external || link.href.startsWith('http')) return link.href;
  return lp(link.href);
}

function columnLinkEnabled(link: FooterLink): boolean {
  if (link.external || link.href.startsWith('http')) return true;
  return isProductHrefEnabled(link.href);
}

const productLinks = t.footer.productLinks.filter(columnLinkEnabled);
const guideLinks = t.footer.guideLinks.filter(columnLinkEnabled);
const helpLinks = t.footer.helpLinks.filter(columnLinkEnabled);
const officialLinks = t.footer.officialLinks.filter(columnLinkEnabled);

const siteBase = Astro.site?.href ?? `${SITE_URL}/`;
const sharePageUrl = new URL(Astro.url.pathname, siteBase).href;
const encodedShareUrl = encodeURIComponent(sharePageUrl);

const shareTargets = [
  {
    href: `https://twitter.com/intent/tweet?url=${encodedShareUrl}`,
    label: t.footer.shareOnX,
    icon: 'x' as const,
  },
  {
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedShareUrl}`,
    label: t.footer.shareOnFacebook,
    icon: 'globe' as const,
  },
  {
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedShareUrl}`,
    label: t.footer.shareOnLinkedIn,
    icon: 'users' as const,
  },
];
---

<footer class="border-t border-border bg-muted/30 py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-5" data-reveal-stagger>
      <div class="space-y-4 sm:col-span-2 lg:col-span-1">
        <a href={lp('/')} class="inline-flex items-center gap-2.5 font-[family-name:var(--font-heading)] text-lg font-bold" aria-label={`${t.site.name} home`}>
          <BrandLogo size={32} class="rounded-md" />
          <BrandWordmark class="text-base font-semibold text-foreground" />
        </a>
        <p class="text-sm leading-relaxed text-muted-foreground">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.products}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.products}</p>
        <ul class="mt-3 space-y-2">
          {productLinks.map((link) => (
            <li>
              <a
                href={columnLinkHref(link)}
                class:list={[
                  'nav-link text-sm text-muted-foreground hover:text-primary inline-flex items-center gap-1',
                  link.external && 'gap-1',
                ]}
                data-nav-link={!link.external ? true : undefined}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                {...(!link.external && link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
                aria-label={link.ariaLabel ?? link.label}
              >
                {link.label}
                {link.external && <Icon name="arrowUpRight" size={14} class="shrink-0 opacity-70" aria-hidden="true" />}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.guides}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.guides}</p>
        <ul class="mt-3 space-y-2">
          {guideLinks.map((link) => (
            <li>
              <a
                href={columnLinkHref(link)}
                class="nav-link text-sm text-muted-foreground hover:text-primary"
                data-nav-link
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
                aria-label={link.ariaLabel ?? link.label}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.help}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.help}</p>
        <ul class="mt-3 space-y-2">
          {helpLinks.map((link) => (
            <li>
              <a
                href={columnLinkHref(link)}
                class:list={['text-sm text-muted-foreground hover:text-primary inline-flex items-center gap-1', link.external && 'gap-1']}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                aria-label={link.ariaLabel ?? link.label}
              >
                {link.label}
                {link.external && <Icon name="arrowUpRight" size={14} class="shrink-0 opacity-70" aria-hidden="true" />}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="space-y-6">
        <nav aria-label={t.footer.official}>
          <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.official}</p>
          <ul class="mt-3 space-y-2">
            {officialLinks.map((link) => (
              <li>
                <a
                  href={columnLinkHref(link)}
                  class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-primary"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={link.ariaLabel ?? link.label}
                >
                  {link.label}
                  <Icon name="arrowUpRight" size={14} class="shrink-0 opacity-70" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.share}</p>
          <p class="mt-2 text-xs text-muted-foreground">{t.footer.shareDescription}</p>
          <div class="mt-3 flex flex-col gap-2">
            {shareTargets.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-full border border-border bg-background/80 px-3 py-2 text-xs font-medium text-foreground transition-colors hover:border-primary/40 hover:text-primary"
                aria-label={item.label}
              >
                <Icon name={item.icon} size={14} class="shrink-0" aria-hidden="true" />
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <Separator class="my-8" />
    <p class="text-left text-sm text-muted-foreground">
      &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
    </p>
    <p class="mt-2 text-left text-xs text-muted-foreground">
      {trademarkBefore}
      {GAME.officialUrl ? (
        <a href={GAME.officialUrl} rel="noopener noreferrer" target="_blank">{GAME.name}</a>
      ) : (
        GAME.name
      )}
      {trademarkAfter}
    </p>
  </div>
</footer>
